# Copy to .env for `npm run dev`. Production builds fail if any of these (except Umami) is
# missing; in CI they come from the repository variables.
# Worker URL (npm run dev in apps/worker/).
PUBLIC_API_URL=http://localhost:8787
# Turnstile test site key: the widget always passes.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Data controller shown in the privacy notice (required by production builds).
PUBLIC_CONTROLLER_NAME=Mario Rossi
PUBLIC_CONTROLLER_EMAIL=privacy@example.org
# Umami Cloud website ID: leave unset to load no analytics script.
# PUBLIC_UMAMI_WEBSITE_ID=
