---
// Every page under /<lang>/: metadata, header, footer and the scripts shared by all pages.
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import { UMAMI_WEBSITE_ID } from "../config/env";
import { LOCALES, type Locale, strings } from "../i18n";
import { href } from "../lib/urls";
import Bare from "./Bare.astro";

interface Props {
  lang: Locale;
  /** Path of the page below /<lang>/, e.g. "subscribe/"; used for the language switcher. */
  page?: string;
  /** Plain text, without *emphasis* markers. */
  title?: string;
  /** Load the Turnstile (anti-bot) script. */
  turnstile?: boolean;
  /**
   * Load the analytics script. Off on the manage page: its manage token sits in sessionStorage,
   * where any third-party script could read it.
   */
  analytics?: boolean;
}

const { lang, page = "", title, turnstile = false, analytics = true } = Astro.props;
const t = strings[lang];
const fullTitle = title ? `${title} · PostTheDoc` : `PostTheDoc · ${t.meta.tagline}`;
const url = (l: Locale) => new URL(href(l, page), Astro.site).href;
// Strings for the browser scripts; "<" is escaped so the JSON cannot close the <script> tag.
const clientStrings = JSON.stringify(t.client).replace(/</g, "\\u003c");
---

<Bare lang={lang} title={fullTitle} reveal>
  <Fragment slot="head">
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={url(lang)} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={url(l)} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta name="theme-color" content="#f5f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111016" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="no-referrer" />
    {
      turnstile && (
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
          async
          defer
        />
      )
    }
    {
      // Cookieless pageviews, without the query string and the hash: they may carry personal
      // data (the manage link carries its token in the hash).
      analytics && UMAMI_WEBSITE_ID && (
        <script
          is:inline
          src="https://cloud.umami.is/script.js"
          data-website-id={UMAMI_WEBSITE_ID}
          data-exclude-search="true"
          data-exclude-hash="true"
          data-do-not-track="true"
          defer
        />
      )
    }
    <script is:inline type="application/json" id="client-strings" set:html={clientStrings} />
  </Fragment>

  <div class="page-noise" aria-hidden="true"></div>
  <a class="skip-link" href="#main">{t.nav.skip}</a>
  <SiteHeader lang={lang} page={page} />
  <main id="main">
    <slot />
  </main>
  <SiteFooter lang={lang} />

  <script>
    import "../scripts/ui";
  </script>
</Bare>
