---
// Positions per month, one small chart per group of positions (each with its own scale).
import type { Group, Month } from "../../lib/observatory";

interface Props {
  months: Month[];
  groups: Group[];
  groupLabels: Record<string, string>;
  lang: string;
}

const { months, groups, groupLabels, lang } = Astro.props;
const WIDTH = 300;
const HEIGHT = 140;
const TOP = 18;
const BOTTOM = 22;
const plot = HEIGHT - TOP - BOTTOM;
const step = months.length ? WIDTH / months.length : WIDTH;
const bar = Math.min(28, step * 0.6);
const label = new Intl.DateTimeFormat(lang, { month: "short", year: "2-digit", timeZone: "UTC" });
const monthName = (key: string) => label.format(new Date(`${key}-01T00:00:00Z`));
const integer = new Intl.NumberFormat(lang);
---

<div class="obs-trend">
  {
    groups.map((group) => {
      const values = months.map((m) => m.positions[group]);
      const max = Math.max(1, ...values);
      const top = values.indexOf(Math.max(...values));
      return (
        <figure class="obs-trend-chart">
          <figcaption>{groupLabels[group]}</figcaption>
          <svg viewBox={`0 0 ${WIDTH} ${HEIGHT}`} role="img" aria-label={groupLabels[group]}>
            <line x1="0" x2={WIDTH} y1={TOP + plot} y2={TOP + plot} class="obs-axis" />
            {months.map((m, i) => {
              const h = (m.positions[group] / max) * plot;
              const x = i * step + (step - bar) / 2;
              return (
                <g>
                  <rect x={x} y={TOP + plot - h} width={bar} height={Math.max(h, 0)} rx="4" class="obs-bar">
                    <title>{`${monthName(m.month)}: ${integer.format(m.positions[group])}`}</title>
                  </rect>
                  {i === top && m.positions[group] > 0 && (
                    <text x={x + bar / 2} y={TOP + plot - h - 5} class="obs-value">
                      {integer.format(m.positions[group])}
                    </text>
                  )}
                  {(months.length <= 6 || i % 2 === 0) && (
                    <text x={x + bar / 2} y={HEIGHT - 6} class="obs-tick">
                      {monthName(m.month)}
                    </text>
                  )}
                </g>
              );
            })}
          </svg>
        </figure>
      );
    })
  }
</div>
