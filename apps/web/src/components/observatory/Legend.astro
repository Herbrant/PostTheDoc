---
// The colours of the observatory's maps: how far each region or university is from the national
// average.
import type { Tone } from "../../lib/observatory";
import { TONE_ORDER } from "../../scripts/lib/observatory-view";

interface Props {
  labels: Record<Tone, string>;
}

const { labels } = Astro.props;
---

<ul class="obs-legend">
  {
    TONE_ORDER.map((tone) => (
      <li>
        <span class={`obs-swatch obs-${tone}`} aria-hidden="true" />
        {labels[tone]}
      </li>
    ))
  }
</ul>
