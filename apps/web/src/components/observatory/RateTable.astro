---
// The figures behind a map, for reading them exactly (and without colours). The page's script
// refills the body when the reader changes what to show.
interface Props {
  id: string;
  caption: string;
  headers: string[];
  rows: { code: string; cells: string[] }[];
}

const { id, caption, headers, rows } = Astro.props;
---

<div class="obs-table-wrap">
  <table class="obs-table" data-table={id}>
    <caption>{caption}</caption>
    <thead>
      <tr>{headers.map((h, i) => <th scope="col" class={i ? "num" : undefined}>{h}</th>)}</tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr data-code={row.code}>
            {row.cells.map((cell, i) =>
              i === 0 ? <th scope="row">{cell}</th> : <td class="num">{cell}</td>,
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
