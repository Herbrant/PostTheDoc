---
// Application windows per group of positions: one bar per group, split into day ranges.
import type { WindowGroup } from "../../lib/observatory";

interface Props {
  groups: WindowGroup[];
  groupLabels: Record<string, string>;
  buckets: string[];
  /** e.g. "median {n} days", "{n} calls". */
  median: string;
  calls: string;
  callsOne: string;
  lang: string;
}

const { groups, groupLabels, buckets, median, calls, callsOne, lang } = Astro.props;
const WIDTH = 640;
const BAR = 26;
const GAP = 2;
const percent = new Intl.NumberFormat(lang, { style: "percent", maximumFractionDigits: 0 });
const fill = (text: string, n: number | string) => text.replace("{n}", String(n));

const rows = groups.map((g) => {
  const total = g.buckets.reduce((a, b) => a + b, 0);
  let x = 0;
  const segments = g.buckets.map((count, i) => {
    const width = total ? (count / total) * WIDTH : 0;
    const segment = { i, x, width: Math.max(0, width - GAP), count, share: total ? count / total : 0 };
    x += width;
    return segment;
  });
  return { ...g, total, segments };
});
---

<div class="obs-window">
  <ul class="obs-legend obs-legend-ordinal">
    {
      buckets.map((label, i) => (
        <li>
          <span class={`obs-swatch obs-step-${i}`} aria-hidden="true" />
          {label}
        </li>
      ))
    }
  </ul>
  {
    rows.map((row) => (
      <div class="obs-window-row">
        <p class="obs-window-label">
          <strong>{groupLabels[row.group]}</strong>
          <span>
            {row.calls === 1 ? callsOne : fill(calls, row.calls)}
            {row.median !== null && ` · ${fill(median, row.median)}`}
          </span>
        </p>
        <svg viewBox={`0 0 ${WIDTH} ${BAR}`} role="img" aria-label={groupLabels[row.group]}>
          {row.segments.map((s) =>
            s.width > 0 ? (
              <g>
                <rect x={s.x} y="0" width={s.width} height={BAR} rx="4" class={`obs-step-${s.i}`}>
                  <title>{`${buckets[s.i]}: ${s.count} (${percent.format(s.share)})`}</title>
                </rect>
                {s.width >= 44 && (
                  <text x={s.x + 8} y={BAR / 2} class={`obs-bar-label obs-on-step-${s.i}`}>
                    {percent.format(s.share)}
                  </text>
                )}
              </g>
            ) : null,
          )}
        </svg>
      </div>
    ))
  }
</div>
