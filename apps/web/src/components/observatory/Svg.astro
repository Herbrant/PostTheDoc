---
// A chart drawn from its spec (scripts/lib/observatory-charts.ts): the page's script redraws the
// same spec in the browser.
import type { ChartSpec, SvgNode } from "../../scripts/lib/observatory-charts";

interface Props {
  spec?: ChartSpec;
  node?: SvgNode;
  /** Ties the chart to the page's script. */
  id?: string;
}

const { spec, node, id } = Astro.props;
const Tag = node?.tag ?? "g";
---

{
  spec ? (
    <svg viewBox={spec.viewBox} role="img" aria-label={spec.label} data-chart={id}>
      {spec.nodes.map((child) => (
        <Astro.self node={child} />
      ))}
    </svg>
  ) : (
    node && (
      <Tag {...node.attrs}>
        {node.text}
        {(node.children ?? []).map((child) => (
          <Astro.self node={child} />
        ))}
      </Tag>
    )
  )
}
