---
// Runs before the first paint: saved theme or system preference and, optionally, the class that
// enables the reveal-on-scroll animations (scripts/ui/reveal.ts).
import { STORAGE_KEYS } from "../../config/storage-keys";

interface Props {
  reveal?: boolean;
}

const { reveal = false } = Astro.props;
const themeKey = STORAGE_KEYS.theme;
---

<script is:inline define:vars={{ themeKey, reveal }}>
  const root = document.documentElement;
  const saved = localStorage.getItem(themeKey);
  const system = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  root.dataset.theme = saved === "light" || saved === "dark" ? saved : system;
  const motion = !matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reveal && motion && "IntersectionObserver" in window) root.classList.add("has-reveal");
</script>
