---
// Served by GitHub Pages for every missing path, so it is in every language.
import Emph from "../components/ui/Emph.astro";
import Icon from "../components/ui/Icon.astro";
import { LOCALES, strings } from "../i18n";
import Bare from "../layouts/Bare.astro";
import { href } from "../lib/urls";
---

<Bare lang="it" title="404 · PostTheDoc">
  <main class="shell not-found">
    <p class="not-found-code">4<i></i>4</p>
    {
      LOCALES.map((lang) => (
        <section lang={lang}>
          <h1>
            <Emph text={strings[lang].notFound.title} />
          </h1>
          <p>{strings[lang].notFound.text}</p>
          <a class="button button-primary" href={href(lang)}>
            PostTheDoc · {strings[lang].nav.home}
            <Icon name="arrow" />
          </a>
        </section>
      ))
    }
  </main>
</Bare>
