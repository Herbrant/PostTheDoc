---
// Language picker: remembered choice, then browser language; links for browsers without JS.
import { STORAGE_KEYS } from "../config/storage-keys";
import { DEFAULT_LOCALE, LOCALES, strings } from "../i18n";
import Bare from "../layouts/Bare.astro";
import { absolute, asset, href } from "../lib/urls";

const base = asset("");
const localeKey = STORAGE_KEYS.locale;
// Crawlers do not run the redirect, so this page needs the same title and description.
const { meta } = strings[DEFAULT_LOCALE];
---

<Bare lang={DEFAULT_LOCALE} title={`PostTheDoc · ${meta.tagline}`}>
  <Fragment slot="head">
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={absolute(base, Astro.site)} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={absolute(href(l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(base, Astro.site)} />
    <script is:inline define:vars={{ base, localeKey, locales: LOCALES }}>
      let saved = null;
      try {
        saved = localStorage.getItem(localeKey);
      } catch {
        // Storage blocked: go by the browser language.
      }
      const browser = navigator.language.slice(0, 2);
      const lang = locales.includes(saved) ? saved : locales.includes(browser) ? browser : "en";
      location.replace(`${base}${lang}/${location.search}${location.hash}`);
    </script>
  </Fragment>
  <main class="shell not-found">
    <h1>PostTheDoc</h1>
    <p>
      {
        LOCALES.map((l, i) => (
          <>
            {i > 0 && " · "}
            <a href={href(l)} lang={l}>
              {strings[l].prefs.languages[l]}
            </a>
          </>
        ))
      }
    </p>
  </main>
</Bare>
