---
import ItalyMap from "../../components/observatory/ItalyMap.astro";
import Legend from "../../components/observatory/Legend.astro";
import RateTable from "../../components/observatory/RateTable.astro";
import Svg from "../../components/observatory/Svg.astro";
import BackLink from "../../components/ui/BackLink.astro";
import Emph from "../../components/ui/Emph.astro";
import { Content as English } from "../../content/observatory/en.md";
import { Content as Italian } from "../../content/observatory/it.md";
import { format, type Locale, localePaths, plain, strings } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { dayOf, type Tone } from "../../lib/observatory";
import { CSV_FILES } from "../../lib/observatory-csv";
import { loadObservatory } from "../../lib/observatory-data";
import { GROUP_KEYS, MEASURES } from "../../lib/observatory-figures";
import { asset } from "../../lib/urls";
import { trendSpec, windowSpec } from "../../scripts/lib/observatory-charts";
import {
  byRate,
  byShare,
  formats,
  otherCells,
  rateCells,
  rateView,
  shareCells,
  shareView,
  windowCells,
} from "../../scripts/lib/observatory-view";

export const getStaticPaths = localePaths;

const lang = Astro.params.lang as Locale;
const t = strings[lang].observatory;
const Method = lang === "it" ? Italian : English;
const data = loadObservatory(lang);
const fig = data?.figures;
const f = formats(lang);
const date = new Intl.DateTimeFormat(lang, {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// What the page shows before the reader picks: permanent positions per staff, by region.
const GROUP = "permanent";
const MEASURE = "staff";

const began = fig ? dayOf(fig.period.began) : "";
const today = fig ? dayOf(fig.period.end) : "";
const firstYear = fig ? fig.period.began.getUTCFullYear() : 0;
const lastYear = fig ? fig.period.end.getUTCFullYear() : 0;
const years = fig ? Array.from({ length: lastYear - firstYear + 1 }, (_, i) => firstYear + i) : [];
const longer = fig
  ? fig.period.end.getTime() - fig.period.began.getTime() > 365 * 86_400_000
  : false;

const windowLabels = {
  groups: t.groups,
  buckets: t.window.buckets,
  median: t.window.median,
  calls: t.window.calls,
  callsOne: t.window.callsOne,
  label: plain(t.window.title),
};
const trendLabels = { partialMonth: t.trend.partialMonth, partialYear: t.trend.partialYear };

// What the page's script needs to compute any period: everything but the calls, fetched apart.
const payload = data && {
  callsUrl: asset("observatory/calls.json"),
  units: data.units,
  names: data.names,
  began,
  today,
  strings: {
    tones: t.tones,
    tonesShare: t.tonesShare,
    per: t.per,
    measures: t.measures,
    national: t.national,
    nationalShare: t.nationalShare,
    region: t.table.region,
    university: t.table.university,
    period: t.period,
    short: t.short,
    undated: t.window.undated,
    loading: t.range.loading,
    error: t.range.error,
    window: windowLabels,
    trend: { ...trendLabels, leadMonth: t.trend.leadMonth, leadYear: t.trend.leadYear },
    groups: t.groups,
  },
};

const territory = fig?.territory[`${GROUP}/${MEASURE}`];
const territoryRegions = (territory?.regions.rows ?? []).map(rateView);
const territoryRows = [...territoryRegions, ...(territory?.universities.rows ?? []).map(rateView)];
const precarityRegions = (fig?.precarity.regions.rows ?? []).map(shareView);
const precarityRows = [
  ...precarityRegions,
  ...(fig?.precarity.universities.rows ?? []).map(shareView),
];
const name = (code: string) => data?.names[code] ?? code;
const rateTitle = (row: { code: string; rate: number; tone: Tone }) =>
  `${name(row.code)}: ${f.decimal(row.rate)} ${t.per[MEASURE]} · ${t.tones[row.tone]}`;
const shareTitle = (row: { code: string; share: number; tone: Tone }) =>
  `${name(row.code)}: ${f.percent(row.share)} · ${t.tonesShare[row.tone]}`;
const tonesOf = (rows: { code: string; tone: Tone }[]) =>
  Object.fromEntries(rows.map((r) => [r.code, r.tone]));

const rateHeaders = [
  t.table.region,
  t.table.observed,
  capitalize(t.measures[MEASURE]),
  `${t.table.rate} (${t.per[MEASURE]})`,
  t.table.interval,
  t.table.ratio,
];
const shareHeaders = [
  t.table.region,
  t.table.precarious,
  t.table.total,
  t.table.share,
  t.table.interval,
];
// "<" is escaped so the JSON cannot close the <script> tag.
const json = JSON.stringify(payload).replace(/</g, "\\u003c");
---

<Base lang={lang} page="observatory/" title={plain(t.title)}>
  <div class="shell obs-page">
    <BackLink lang={lang} />

    <header class="calls-heading obs-heading" data-reveal>
      <div>
        <p class="section-kicker">{t.kicker}</p>
        <h1><Emph text={t.title} /></h1>
        <p class="page-lead">{t.lead}</p>
      </div>
      {
        fig && (
          <dl class="calls-stats">
            <div>
              <dt>{t.stats.calls}</dt>
              <dd data-stat="calls">{f.integer(fig.calls)}</dd>
            </div>
            <div>
              <dt>{t.stats.universities}</dt>
              <dd>{fig.universities}</dd>
            </div>
            <div>
              <dt>{t.stats.days}</dt>
              <dd data-stat="days">{fig.period.days}</dd>
            </div>
          </dl>
        )
      }
    </header>

    {!fig && <p class="obs-notice">{t.empty}</p>}
    {
      fig && (
        <>
          <form class="obs-controls obs-range" data-range aria-label={t.range.legend}>
            <fieldset>
              <legend class="calls-label">{t.range.legend}</legend>
              <div class="obs-range-fields">
                <label class="obs-date">
                  <span>{t.range.from}</span>
                  <input type="date" name="from" min={began} max={today} value={began} required />
                </label>
                <label class="obs-date">
                  <span>{t.range.to}</span>
                  <input type="date" name="to" min={began} max={today} value={today} required />
                </label>
              </div>
              <div class="obs-presets">
                <button type="button" class="obs-preset" data-from={began} data-to={today}>
                  {t.range.all}
                </button>
                {longer && (
                  <button type="button" class="obs-preset" data-last-year>
                    {t.range.lastYear}
                  </button>
                )}
                {years.length > 1 &&
                  years.map((year) => (
                    <button
                      type="button"
                      class="obs-preset"
                      data-from={year === firstYear ? began : `${year}-01-01`}
                      data-to={year === lastYear ? today : `${year}-12-31`}
                    >
                      {year}
                    </button>
                  ))}
              </div>
            </fieldset>
            <p class="obs-period" aria-live="polite" data-period>
              {format(t.period, {
                start: date.format(fig.period.start),
                end: date.format(fig.period.end),
              })}
            </p>
            <p class="obs-hint" data-range-status hidden />
          </form>

          <p class="obs-notice" role="note" data-short hidden={!fig.period.short}>
            {format(t.short, { days: fig.period.days })}
          </p>

          <section class="obs-section" aria-labelledby="obs-territory">
            <p class="section-kicker">{t.territory.kicker}</p>
            <h2 id="obs-territory">
              <Emph text={t.territory.title} />
            </h2>
            <p class="obs-lead">{t.territory.lead}</p>

            <form class="obs-controls" data-controls="territory" aria-label={t.controls}>
              <fieldset>
                <legend class="calls-label">{t.group}</legend>
                {GROUP_KEYS.map((g) => (
                  <label class="obs-choice">
                    <input type="radio" name="group" value={g} checked={g === GROUP} />
                    <span>{t.groups[g]}</span>
                  </label>
                ))}
              </fieldset>
              <fieldset>
                <legend class="calls-label">{t.measure}</legend>
                {MEASURES.map((m) => (
                  <label class="obs-choice">
                    <input type="radio" name="measure" value={m} checked={m === MEASURE} />
                    <span>{t.measures[m]}</span>
                  </label>
                ))}
              </fieldset>
              <fieldset>
                <legend class="calls-label">{t.view}</legend>
                <label class="obs-choice">
                  <input type="radio" name="view" value="regions" checked />
                  <span>{t.views.regions}</span>
                </label>
                <label class="obs-choice">
                  <input type="radio" name="view" value="universities" />
                  <span>{t.views.universities}</span>
                </label>
              </fieldset>
              <p class="obs-hint" data-residents-note hidden>
                {t.residentsRegionsOnly}
              </p>
            </form>

            <div class="obs-figure">
              <ItalyMap
                id="territory"
                shape={data.map}
                label={plain(t.territory.title)}
                view="regions"
                classes={tonesOf(territoryRows)}
                titles={Object.fromEntries(territoryRows.map((r) => [r.code, rateTitle(r)]))}
              />
              <div class="obs-side">
                <p class="obs-national" data-national="territory">
                  {format(t.national, {
                    rate: f.decimal(territory?.regions.national ?? 0),
                    unit: t.per[MEASURE],
                  })}
                </p>
                <Legend labels={t.tones} />
                <p class="obs-hint">{t.mapNote}</p>
                <p class="obs-hint">{t.sizeNote}</p>
              </div>
            </div>

            <details class="obs-details">
              <summary>{t.table.showTable}</summary>
              <RateTable
                id="territory"
                caption={plain(t.territory.title)}
                headers={rateHeaders}
                rows={byRate(territoryRegions).map((r) => ({
                  code: r.code,
                  cells: rateCells(r, name(r.code), f),
                }))}
              />
            </details>

            <details class="obs-details">
              <summary>{t.others.title}</summary>
              <p class="obs-hint">{t.others.lead}</p>
              <div class="obs-table-wrap">
                <table class="obs-table" data-table="others">
                  <caption>{t.others.title}</caption>
                  <thead>
                    <tr>
                      <th scope="col">{t.table.name}</th>
                      {GROUP_KEYS.map((g) => (
                        <th scope="col" class="num">
                          {t.groups[g]}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {fig.others.map((o) => (
                      <tr>
                        {otherCells(o, f).map((cell, i) =>
                          i === 0 ? <th scope="row">{cell}</th> : <td class="num">{cell}</td>,
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </section>

          <section class="obs-section" aria-labelledby="obs-precarity">
            <p class="section-kicker">{t.precarity.kicker}</p>
            <h2 id="obs-precarity">
              <Emph text={t.precarity.title} />
            </h2>
            <p class="obs-lead">{t.precarity.lead}</p>

            <form class="obs-controls" data-controls="precarity" aria-label={t.controls}>
              <fieldset>
                <legend class="calls-label">{t.view}</legend>
                <label class="obs-choice">
                  <input type="radio" name="view" value="regions" checked />
                  <span>{t.views.regions}</span>
                </label>
                <label class="obs-choice">
                  <input type="radio" name="view" value="universities" />
                  <span>{t.views.universities}</span>
                </label>
              </fieldset>
            </form>

            <div class="obs-figure">
              <ItalyMap
                id="precarity"
                shape={data.map}
                label={plain(t.precarity.title)}
                view="regions"
                classes={tonesOf(precarityRows)}
                titles={Object.fromEntries(precarityRows.map((r) => [r.code, shareTitle(r)]))}
              />
              <div class="obs-side">
                <p class="obs-national" data-national="precarity">
                  {format(t.nationalShare, { share: f.percent(fig.precarity.regions.national) })}
                </p>
                <Legend labels={t.tonesShare} />
                <p class="obs-hint">{t.mapNote}</p>
                <p class="obs-hint">{t.sizeNote}</p>
              </div>
            </div>

            <details class="obs-details">
              <summary>{t.table.showTable}</summary>
              <RateTable
                id="precarity"
                caption={plain(t.precarity.title)}
                headers={shareHeaders}
                rows={byShare(precarityRegions).map((r) => ({
                  code: r.code,
                  cells: shareCells(r, name(r.code), f),
                }))}
              />
            </details>
          </section>

          <section class="obs-section" aria-labelledby="obs-window">
            <p class="section-kicker">{t.window.kicker}</p>
            <h2 id="obs-window">
              <Emph text={t.window.title} />
            </h2>
            <p class="obs-lead">{t.window.lead}</p>
            <div class="obs-window">
              <ul class="obs-legend obs-legend-ordinal">
                {t.window.buckets.map((label, i) => (
                  <li>
                    <span class={`obs-swatch obs-step-${i}`} aria-hidden="true" />
                    {label}
                  </li>
                ))}
              </ul>
              <Svg id="window" spec={windowSpec(fig.windows.groups, windowLabels, lang)} />
            </div>
            <p class="obs-hint">
              {t.window.caveat}{" "}
              <span data-undated>
                {fig.windows.undated > 0 &&
                  format(t.window.undated, { n: f.integer(fig.windows.undated) })}
              </span>
            </p>
            <details class="obs-details">
              <summary>{t.window.universitiesTitle}</summary>
              <p class="obs-hint">{t.window.universitiesNote}</p>
              <div class="obs-table-wrap">
                <table class="obs-table" data-table="window">
                  <caption>{t.window.universitiesTitle}</caption>
                  <thead>
                    <tr>
                      <th scope="col">{t.table.university}</th>
                      <th scope="col" class="num">
                        {t.table.calls}
                      </th>
                      <th scope="col" class="num">
                        {t.table.median}
                      </th>
                      <th scope="col" class="num">
                        {t.table.short}
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {windowCells(fig.windows.universities, f).map((cells) => (
                      <tr>
                        {cells.map((cell, i) =>
                          i === 0 ? <th scope="row">{cell}</th> : <td class="num">{cell}</td>,
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </section>

          <section class="obs-section" aria-labelledby="obs-trend">
            <p class="section-kicker">{t.trend.kicker}</p>
            <h2 id="obs-trend">
              <Emph text={t.trend.title} />
            </h2>
            <p class="obs-lead" data-trend-lead>
              {fig.trend.granularity === "year" ? t.trend.leadYear : t.trend.leadMonth}
            </p>
            <div class="obs-trend">
              {GROUP_KEYS.map((group) => (
                <figure class="obs-trend-chart">
                  <figcaption>{t.groups[group]}</figcaption>
                  <Svg
                    id={`trend-${group}`}
                    spec={trendSpec(fig.trend, group, t.groups[group], trendLabels, lang)}
                  />
                </figure>
              ))}
            </div>
            <p
              class="obs-hint obs-partial-note"
              data-partial-note
              hidden={!fig.trend.buckets.some((b) => b.partial)}
            >
              <span class="obs-swatch obs-swatch-partial" aria-hidden="true" />
              {t.trend.partialNote}
            </p>
          </section>
        </>
      )
    }

    <section class="obs-section obs-method" aria-labelledby="obs-method">
      <p class="section-kicker">{t.method.kicker}</p>
      <h2 id="obs-method">
        <Emph text={t.method.title} />
      </h2>
      <div class="prose">
        <Method />
      </div>
      {
        fig && (
          <div class="obs-downloads">
            <p class="calls-label">{t.downloads}</p>
            <ul>
              {CSV_FILES.map((file) => (
                <li>
                  <a href={asset(`observatory/${file}.csv`)} download data-csv={file}>
                    {t.files[file]}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>
  </div>
  {data && <script is:inline type="application/json" id="observatory-data" set:html={json} />}
</Base>

<script>
  import "../../scripts/pages/observatory";
</script>
