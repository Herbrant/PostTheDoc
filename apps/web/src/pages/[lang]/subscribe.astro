---
import { CAPTCHA_ACTIONS } from "@postthedoc/shared/api";
import Captcha from "../../components/forms/Captcha.astro";
import PreferencesForm from "../../components/forms/PreferencesForm.astro";
import BackLink from "../../components/ui/BackLink.astro";
import EmailField from "../../components/ui/EmailField.astro";
import Emph from "../../components/ui/Emph.astro";
import Icon from "../../components/ui/Icon.astro";
import { type Locale, localePaths, plain, strings } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { ordinal } from "../../lib/format";
import { href } from "../../lib/urls";

export const getStaticPaths = localePaths;

const lang = Astro.params.lang as Locale;
const t = strings[lang].subscribe;
const [privacyBefore, privacyAfter] = t.privacy.split("{link}");
---

<Base lang={lang} page="subscribe/" title={plain(t.title)} turnstile>
  <div class="shell form-page">
    <BackLink lang={lang} />

    <ol class="wizard-steps" data-wizard-steps>
      {
        t.stepLabels.map((label, i) => (
          <li data-step={i + 1} aria-current={i === 0 ? "step" : undefined}>
            <span class="wizard-index">{ordinal(i)}</span>
            <span>{label}</span>
          </li>
        ))
      }
    </ol>

    <noscript><p class="message error">{t.noscript}</p></noscript>
    <p id="message" class="message" role="alert" hidden></p>

    <form id="step-email" class="wizard-panel" novalidate>
      <p class="section-kicker">{t.kicker}</p>
      <h1><Emph text={t.emailTitle} /></h1>
      <p class="page-lead">{t.emailLead}</p>
      <EmailField lang={lang} />
      <button type="submit" class="button button-primary">{t.continue}<Icon name="arrow" /></button>
    </form>

    <form id="step-prefs" class="wizard-panel" novalidate hidden>
      <p class="section-kicker">{t.kicker}</p>
      <h1><Emph text={t.prefsTitle} /></h1>
      <p class="page-lead">{t.prefsLead}</p>
      <p class="email-recap">
        <span>{t.emailFor} <strong data-email-recap></strong></span>
        <button type="button" class="text-button" data-change-email>{t.change}</button>
      </p>
      <PreferencesForm lang={lang} />
      <Captcha lang={lang} id="turnstile-subscribe" action={CAPTCHA_ACTIONS.subscribe} />
      <button type="submit" class="button button-primary button-large">
        {t.submit}<Icon name="arrow" />
      </button>
      <p class="form-note">
        {privacyBefore}<a href={href(lang, "privacy/")}>{t.privacyLink}</a>{privacyAfter}
      </p>
    </form>

    <section id="step-done" class="wizard-panel done" hidden>
      <span class="done-mark" aria-hidden="true"><Icon name="mail" /></span>
      <h1><Emph text={t.doneTitle} /></h1>
      <p class="page-lead" data-done-text data-template={t.doneText}></p>
      <p class="form-note">{t.doneHint}</p>
      <a class="button button-ghost" href={href(lang)}><Icon name="back" />{t.backHome}</a>
    </section>
  </div>
</Base>

<script>
  import "../../scripts/pages/subscribe";
</script>
