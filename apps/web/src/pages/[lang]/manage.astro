---
import Captcha from "../../components/forms/Captcha.astro";
import PreferencesForm from "../../components/forms/PreferencesForm.astro";
import BackLink from "../../components/ui/BackLink.astro";
import EmailField from "../../components/ui/EmailField.astro";
import Emph from "../../components/ui/Emph.astro";
import Icon from "../../components/ui/Icon.astro";
import { type Locale, localePaths, plain, strings } from "../../i18n";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = localePaths;

const lang = Astro.params.lang as Locale;
const t = strings[lang].manage;
---

<Base lang={lang} page="manage/" title={plain(t.title)} turnstile analytics={false}>
  <div class="shell form-page">
    <BackLink lang={lang} />
    <noscript><p class="message error">{t.noscript}</p></noscript>
    <p id="message" class="message" role="alert" hidden></p>

    <form id="manage" novalidate hidden>
      <p class="section-kicker">{t.kicker}</p>
      <h1><Emph text={t.title} /></h1>
      <p class="email-recap">
        <span>{t.preferencesFor} <strong data-user-email></strong></span>
      </p>
      <PreferencesForm lang={lang} open />
      <div class="actions">
        <button type="submit" class="button button-primary">{t.save}<Icon name="check" /></button>
        <button type="button" class="button button-ghost" data-export>{t.export}</button>
        <button type="button" class="button button-danger" data-delete>{t.unsubscribe}</button>
      </div>
    </form>

    <form id="manage-link" novalidate hidden>
      <p class="section-kicker">{t.kicker}</p>
      <h1><Emph text={t.linkTitle} /></h1>
      <p class="page-lead">{t.linkLead}</p>
      <EmailField lang={lang} />
      <Captcha lang={lang} id="turnstile-link" />
      <button type="submit" class="button button-primary">{t.sendLink}<Icon name="arrow" /></button>
    </form>
  </div>
</Base>

<script>
  import "../../scripts/pages/manage";
</script>
