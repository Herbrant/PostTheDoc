---
import Cta from "../../components/sections/Cta.astro";
import { Content as English } from "../../content/philosophy/en.md";
import { Content as Italian } from "../../content/philosophy/it.md";
import { type Locale, localePaths, strings } from "../../i18n";
import Prose from "../../layouts/Prose.astro";

export const getStaticPaths = localePaths;

const lang = Astro.params.lang as Locale;
const t = strings[lang];
const Content = lang === "it" ? Italian : English;
---

<Prose
  lang={lang}
  page="philosophy/"
  kicker={t.philosophy.kicker}
  title={t.philosophy.title}
  documentTitle={t.nav.philosophy}
  mark="“"
>
  <Content />
  <Cta lang={lang} slot="after" />
</Prose>
