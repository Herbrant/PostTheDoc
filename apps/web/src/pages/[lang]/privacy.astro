---
import { controller } from "../../config/env";
import * as english from "../../content/privacy/en.md";
import * as italian from "../../content/privacy/it.md";
import { type Locale, localePaths, strings } from "../../i18n";
import Prose from "../../layouts/Prose.astro";

export const getStaticPaths = localePaths;

const lang = Astro.params.lang as Locale;
const t = strings[lang];

const escapeHtml = (text: string) => text.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
const { name, email } = controller();
const contact = email ? `<a href="mailto:${escapeHtml(email)}">${escapeHtml(email)}</a>` : "…";
// {controllerName} and {controllerEmail} in the markdown are filled in here.
const html = (await (lang === "it" ? italian : english).compiledContent())
  .replaceAll("{controllerName}", escapeHtml(name))
  .replaceAll("{controllerEmail}", contact);
---

<Prose lang={lang} page="privacy/" kicker={t.privacy.kicker} title={t.privacy.title} mark="§">
  <Fragment set:html={html} />
</Prose>
