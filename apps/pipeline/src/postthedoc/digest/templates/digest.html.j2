{% import "_macros.j2" as m %}
{# Colors: light theme of apps/web/src/styles/tokens.css; emails only get inline styles. #}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>PostTheDoc</title>
</head>
<body style="margin:0;padding:0;background:#f5f0e8;font-family:'Segoe UI',system-ui,-apple-system,Helvetica,Arial,sans-serif;color:#16151b;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f0e8;">
<tr><td align="center" style="padding:32px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#fffdf8;border:1px solid #d6d1cb;border-radius:16px;">
  <tr><td style="padding:28px 32px 0;">
    {{ m.brand_header(t) }}
    <p style="margin:24px 0 0;font-size:15px;line-height:1.5;color:#6f6865;"><span style="color:#ff6542;">&#9679;</span>&nbsp; {{ intro }}</p>
  </td></tr>
  {% for role, calls in groups.items() %}
  <tr><td style="padding:24px 32px 0;">
    <h2 style="margin:0 0 4px;font:600 18px/1.3 Georgia,'Times New Roman',serif;letter-spacing:-0.01em;border-bottom:1px solid #d6d1cb;padding-bottom:8px;">{{ role }} <span style="color:#6f6865;font-weight:400;">({{ calls | length }})</span></h2>
    {% for c in calls %}
    <div style="padding:12px 0;border-bottom:1px solid #ebe3d7;">
      <a href="{{ c.url }}" style="color:#7157ff;font-weight:600;text-decoration:none;">{{ c.title }}</a>
      <div style="font-size:14px;line-height:1.5;color:#6f6865;margin-top:4px;">
        {{ c.institution_name }}{% if c.region %} · {{ regions[c.region] }}{% endif %}<br>
        {{ t.sector }}: {{ m.sectors(c, t) }}
        {% if c.positions %} · {{ t.positions }}: {{ c.positions }}{% endif %}<br>
        <strong style="color:#16151b;">{{ t.deadline }}: {{ m.deadline(c, t) }}</strong>
      </div>
    </div>
    {% endfor %}
  </td></tr>
  {% endfor %}
  <tr><td style="padding:24px 32px 28px;font-size:12px;line-height:1.6;color:#6f6865;">
    {{ t.footer }} {{ t.disclaimer }} {{ t.no_reply }}<br>
    <a href="{{ links.manage }}" style="color:#6f6865;">{{ t.manage }}</a> ·
    <a href="{{ links.unsubscribe }}" style="color:#6f6865;">{{ t.unsubscribe }}</a> ·
    <a href="{{ links.privacy }}" style="color:#6f6865;">{{ t.privacy }}</a> ·
    <a href="{{ links.support }}" style="color:#6f6865;">{{ t.support }}</a> ·
    <a href="{{ links.issues }}" style="color:#6f6865;">{{ t.issues }}</a>
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
