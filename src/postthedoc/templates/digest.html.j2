{% macro sectors(c) %}{{ c.ssd | join(", ") if c.ssd else (c.gsd | join(", ") if c.gsd else t.sector_unspecified) }}{% endmacro %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PostTheDoc</title>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#1f2933;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#ffffff;border-radius:8px;">
  <tr><td style="padding:24px 28px 8px;">
    <h1 style="margin:0;font-size:20px;">PostTheDoc</h1>
    <p style="margin:8px 0 0;color:#52606d;">{{ intro }}</p>
  </td></tr>
  {% for role, calls in groups.items() %}
  <tr><td style="padding:16px 28px 0;">
    <h2 style="margin:0 0 8px;font-size:16px;border-bottom:1px solid #e4e7eb;padding-bottom:6px;">{{ role }} ({{ calls | length }})</h2>
    {% for c in calls %}
    <div style="padding:10px 0;border-bottom:1px solid #f0f2f4;">
      <a href="{{ c.url }}" style="color:#1d4ed8;font-weight:600;text-decoration:none;">{{ c.title }}</a>
      <div style="font-size:14px;color:#52606d;margin-top:4px;">
        {{ c.institution_name }}{% if c.region %} · {{ regions[c.region] }}{% endif %}<br>
        {{ t.sector }}: {{ sectors(c) }}
        {% if c.positions %} · {{ t.positions }}: {{ c.positions }}{% endif %}<br>
        <strong>{{ t.deadline }}: {{ c.deadline.strftime("%d/%m/%Y %H:%M") if c.deadline else t.not_available }}</strong>
      </div>
    </div>
    {% endfor %}
  </td></tr>
  {% endfor %}
  <tr><td style="padding:24px 28px;font-size:12px;color:#7b8794;">
    {{ t.footer }}<br>
    <a href="{{ manage_url }}" style="color:#7b8794;">{{ t.manage }}</a> ·
    <a href="{{ unsubscribe_url }}" style="color:#7b8794;">{{ t.unsubscribe }}</a> ·
    <a href="{{ privacy_url }}" style="color:#7b8794;">{{ t.privacy }}</a> ·
    <a href="{{ support_url }}" style="color:#7b8794;">{{ t.support }}</a>
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
