<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PostTheDoc</title>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#1f2933;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#ffffff;border-radius:8px;">
  <tr><td style="padding:24px 28px 8px;">
    <h1 style="margin:0;font-size:20px;">PostTheDoc</h1>
    <p style="margin:8px 0 0;color:#52606d;">
      {{ count }} {{ "nuovo bando corrisponde" if count == 1 else "nuovi bandi corrispondono" }} alle tue preferenze ({{ today.strftime("%d/%m/%Y") }}).
    </p>
  </td></tr>
  {% for role, bandi in groups.items() %}
  <tr><td style="padding:16px 28px 0;">
    <h2 style="margin:0 0 8px;font-size:16px;border-bottom:1px solid #e4e7eb;padding-bottom:6px;">{{ role }} ({{ bandi | length }})</h2>
    {% for b in bandi %}
    <div style="padding:10px 0;border-bottom:1px solid #f0f2f4;">
      <a href="{{ b.url }}" style="color:#1d4ed8;font-weight:600;text-decoration:none;">{{ b.title }}</a>
      <div style="font-size:14px;color:#52606d;margin-top:4px;">
        {{ b.struttura_name }}{% if b.regione %} · {{ regions[b.regione] }}{% endif %}<br>
        Settore: {{ b.ssd | join(", ") if b.ssd else (b.gsd | join(", ") if b.gsd else "non indicato") }}
        {% if b.posti %} · Posti: {{ b.posti }}{% endif %}<br>
        <strong>Scadenza: {{ b.deadline | date_it }}</strong>
      </div>
    </div>
    {% endfor %}
  </td></tr>
  {% endfor %}
  <tr><td style="padding:24px 28px;font-size:12px;color:#7b8794;">
    Ricevi questa email perché sei iscritto a PostTheDoc. Fonte: bandi.mur.gov.it.<br>
    <a href="{{ manage_url }}" style="color:#7b8794;">Modifica preferenze</a> ·
    <a href="{{ unsubscribe_url }}" style="color:#7b8794;">Disiscriviti</a>
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
